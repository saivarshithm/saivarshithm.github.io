{
  "name": "saivarshithm-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"process.argv=['node','astro','dev']; process.env.ASTRO_TELEMETRY_DISABLED='1'; import('./node_modules/astro/bin/astro.mjs')\"",
    "build": "node -e \"process.argv=['node','astro','build']; process.env.ASTRO_TELEMETRY_DISABLED='1'; import('./node_modules/astro/bin/astro.mjs')\"",
    "preview": "node -e \"process.argv=['node','astro','preview']; process.env.ASTRO_TELEMETRY_DISABLED='1'; import('./node_modules/astro/bin/astro.mjs')\""
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lenis": "^1.3.27",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.3"
  }
