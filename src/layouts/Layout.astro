---
import '../styles/global.css';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { MobileDock } from '../components/MobileDock';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Saivarshith Mitukula · Digital Silicon & Power Systems | Vibe-Coded Apps",
  description = "Saivarshith Mitukula — Electrical & Electronics Engineering undergraduate at NITK Surathkal, ex-ISRO URSC research intern. Specializing in RISC-V RTL, Space-Grade Power Electronics, SKY130 VLSI, and High-Velocity Software Platforms."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#F5EFE6]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Saivarshith Mitukula" />
    <meta name="theme-color" content="#F5EFE6" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://saivarshithm.github.io" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://saivarshithm.github.io/saivarshith.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@Saivarshithm" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://saivarshithm.github.io/saivarshith.jpg" />

    <!-- Circuit Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='28' fill='%232E241E'/><circle cx='50' cy='50' r='24' stroke='%238C5E14' stroke-width='6' fill='none'/><circle cx='50' cy='50' r='8' fill='%2310B981'/></svg>" />

    <!-- Google Fonts: Cherry Bomb One, Caveat, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Cherry+Bomb+One&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-[#F5EFE6] text-[#2E241E] antialiased selection:bg-[#FDE68A] selection:text-[#78350F] min-h-[100dvh] flex flex-col font-sans">
    <!-- EdgeDrop Floating Capsule Header -->
    <Header client:load />

    <!-- Main Content Stage -->
    <main class="flex-1 w-full relative">
      <slot />
    </main>

    <!-- EdgeDrop Dark Bedrock Footer -->
    <Footer client:visible />

    <!-- Mobile Floating Glass Dock (< 768px) -->
    <MobileDock client:load />
  </body>
</html>
