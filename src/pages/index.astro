---
import Layout from '../layouts/Layout.astro';
import { HeroBench } from '../components/HeroBench';
import { BuckSimLab } from '../components/BuckSimLab';
import { FlagshipBento } from '../components/FlagshipBento';
import { GitHubExplorer } from '../components/GitHubExplorer';
import { CapabilitiesMatrix } from '../components/CapabilitiesMatrix';
import { ExperienceTimeline } from '../components/ExperienceTimeline';
---

<Layout>
  <div class="relative w-full">
    <!-- 01. The Bench (Hero, Profile, Interactive Terminal Card) -->
    <HeroBench client:load />

    <!-- 02. Interactive PWM & Inductor Ripple Lab (~/saivarshithm/buck-sim) -->
    <BuckSimLab client:visible />

    <!-- 03. Flagship Hardware & Systems (Bento Grid + Mobile Sheet / Desktop Drawer) -->
    <FlagshipBento client:visible />

    <!-- 04. Live GitHub Repository Explorer (Language Telemetry Bar + Real-Time Sync) -->
    <GitHubExplorer client:visible />

    <!-- 05. Capabilities Matrix (Silicon & Power vs Software & Tools) -->
    <CapabilitiesMatrix client:visible />

    <!-- 06. Research & Institutional Experience Timeline (ISRO URSC, NITK Surathkal) -->
    <ExperienceTimeline client:visible />
  </div>
</Layout>
